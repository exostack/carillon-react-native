{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    // CommonJS, not the package's ESM: `expo prebuild` reaches this through
    // `require`, and a plugin it cannot require is a plugin that does not run.
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "customConditions": [],
    "verbatimModuleSyntax": false,
    "declaration": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
